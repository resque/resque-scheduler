<h1><%= h @job_name %></h1>

<p class='intro'>
   This job requires parameters:
</p>

<form style="float:left" action="<%= u "/schedule/requeue_with_params" %>" method="post">
  <table>
  <% @parameters.each do |key, value| %>
  <% value ||= {} %>
    <tr>
      <td>
        <%= h key %>
        <% if value['description'] || value[:description] %>
          <span style="border-bottom:1px dotted;" title="<%= h(value['description'] || value[:description]) %>">(?)</span>
        <% end %>:
      </td>
      <td><input type="text" name="<%= h key %>" value="<%= h(value['default'] || value[:default]) %>"></td>
  <% end %>
  </table>
  <input type="hidden" name="job_name" value="<%= h @job_name %>">
  <input type="submit" value="Queue now">
</form>
